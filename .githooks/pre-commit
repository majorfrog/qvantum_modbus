#!/usr/bin/env python3
"""Pre-commit hook: increment the patch version in manifest.json."""

import json
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
MANIFEST_REL = "custom_components/qvantum_modbus/manifest.json"
MANIFEST = REPO_ROOT / MANIFEST_REL


def _committed_version() -> str | None:
    """Return the version string from HEAD, or None if there are no commits yet."""
    result = subprocess.run(
        ["git", "show", f"HEAD:{MANIFEST_REL}"],
        capture_output=True,
        text=True,
        cwd=str(REPO_ROOT),
    )
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout).get("version")
    except json.JSONDecodeError:
        return None


def main() -> int:
    data = json.loads(MANIFEST.read_text())
    version: str = data.get("version", "0.0.0")

    parts = version.split(".")
    if len(parts) != 3 or not all(p.isdigit() for p in parts):
        print(f"pre-commit: unrecognised version format {version!r} -- skipping bump")
        return 0

    committed = _committed_version()
    if committed is not None and committed != version:
        print(
            f"pre-commit: version already changed ({committed} -> {version}), skipping bump"
        )
        return 0

    major, minor, patch = int(parts[0]), int(parts[1]), int(parts[2])
    new_version = f"{major}.{minor}.{patch + 1}"
    data["version"] = new_version

    MANIFEST.write_text(json.dumps(data, indent=2) + "\n")

    subprocess.run(["git", "add", MANIFEST_REL], check=True, cwd=str(REPO_ROOT))
    print(f"pre-commit: bumped version {version} -> {new_version}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
